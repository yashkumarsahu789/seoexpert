# ─── tools/ app — Firebase (primary backend) ───
# Main repo (../) uses Supabase — tools/ uses Firebase Firestore only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# LifeSolveNow
VITE_SHOP_BASE_URL=https://shop.LifeSolveNow.com
VITE_KEYWORD_PAGES_PUBLIC_BASE=https://shop.LifeSolveNow.com/pages
VITE_SITE_NAME=LifeSolveNow

# Optional — GitHub auto-commit path labels
VITE_GITHUB_REPO=owner/seoexpert

# AI display
VITE_AI_ENABLED=true
VITE_CF_AI_MODEL=llama

# n8n webhooks (production pipeline only — optional in local tools UI)
VITE_N8N_BASE_URL=https://lifesolvenow.onrender.com
VITE_N8N_KEYWORD_PAGES_WEBHOOK_URL=
VITE_N8N_KEYWORD_PAGES_INDEXING_WEBHOOK_URL=

# ─── Daily automation (scripts/daily-keyword-page.mjs — no n8n) ───
# Groq key: grok= or GROQ_API_KEY= in tools/.env (GitHub secret: GROQ_API_KEY)
KEYWORD_PAGES_USE_AI=true
KEYWORD_PAGES_DAILY_MAX=1
KEYWORD_PAGES_SKIP=chatgpt,openai chatgpt
# VITE_TOOLS_PUBLIC_URL=https://shop.LifeSolveNow.com
# SERP_API_KEY=optional SerpAPI for better SERP top URL

# ─── NOT used by tools React app (main repo ../.env + n8n Render) ───
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
