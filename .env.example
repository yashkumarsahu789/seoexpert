# React app (VITE_ only)
# Note: tools/ sub-app uses Firebase — see tools/.env.example (not Supabase)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SHOP_BASE_URL=https://shop.LifeSolveNow.com
VITE_CDN_BASE_URL=https://cd.LifeSolveNow.com
VITE_SHOP_SITEMAP_URL=https://shop.LifeSolveNow.com/sitemap.xml
VITE_SITE_NAME=LifeSolveNow
VITE_N8N_BASE_URL=https://lifesolvenow.onrender.com
VITE_N8N_AUDIT_WEBHOOK_URL=https://lifesolvenow.onrender.com/webhook/62d11c24-940d-456d-a512-5d27089c0a69
VITE_N8N_SHOP_RANK_WEBHOOK_URL=https://lifesolvenow.onrender.com/webhook/shop-rank-check
VITE_N8N_KEEPALIVE_WEBHOOK_URL=https://lifesolvenow.onrender.com/webhook/render-lifetime-guard-ping

# WhatsApp automation (local Node — npm run wa:server)
VITE_WA_AUTOMATION_URL=http://127.0.0.1:3742

# ─── n8n API (Cursor deploy only) ───
N8N_API_URL=https://lifesolvenow.onrender.com
N8N_API_KEY=

# ─── n8n on Render (audit pipeline) ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEZONE=Asia/Kolkata

# ─── AI Center — multi-agent orchestration + GitHub auto-commit ───
VITE_GITHUB_REPO=owner/repo-name

# Supabase Edge Function secret (NOT in VITE_):
# GITHUB_TOKEN=ghp_...   # full repo perms PAT — supabase secrets set GITHUB_TOKEN=...

VITE_AI_ENABLED=true
VITE_GEMINI_MODEL=gemini-flash-latest
VITE_N8N_BULK_LLM_WEBHOOK_URL=https://lifesolvenow.onrender.com/webhook/bulk-llm-enqueue
VITE_N8N_KEYWORD_PAGES_WEBHOOK_URL=https://lifesolvenow.onrender.com/webhook/keyword-pages-run

# n8n Render env (keyword pages daily pipeline)
# GITHUB_REPO=owner/seoexpert
# KEYWORD_PAGES_PATH=tools/public/pages
# KEYWORD_PAGES_DAILY_MAX=1
# KEYWORD_PAGES_PUBLIC_BASE=https://shop.LifeSolveNow.com/pages
# Coupon / Webflow promo pages live in webflow/coupon-sites/ (see webflow/WEBFLOW.md)
# COUPON_SITES_PUBLIC_BASE=https://shop.LifeSolveNow.com/coupon-sites
# VITE_COUPON_SITES_PUBLIC_BASE=https://shop.LifeSolveNow.com/coupon-sites
# KEYWORD_PAGES_USE_AI_SEO=true
# INDEXNOW_KEY=your-random-32-char-key
# VITE_N8N_KEYWORD_PAGES_INDEXING_WEBHOOK_URL=https://lifesolvenow.onrender.com/webhook/keyword-pages-indexing
# VITE_WEBFLOW_APP_URL=http://localhost:5174

# n8n Render env (Webflow automation — set in webflow/.env or repo root .env)
# WEBFLOW_API_KEY=ws-...
# WEBFLOW_MASTER_SITE_ID=674abc...     # 24-char Site ID (NOT demosite-57cbb8)
# WEBFLOW_SITE_SHORT_NAME=demosite-57cbb8
# WEBFLOW_COUPON_COLLECTION_ID=6a3c3ce...
# WEBFLOW_MASTER_SITE_ID=
# WEBFLOW_COUPON_COLLECTION_ID=
# WEBFLOW_SITE_POOL=siteId1,siteId2
# WEBFLOW_WORKSPACE_ID=
# WEBFLOW_TEMPLATE_NAME=
# WEBFLOW_USE_AI=true

# ─── Gemini AI (classifier + audit) ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Rotation pool (optional): Google_API_KEY1= … GEMINI_API_KEY4= …

# ─── Legacy audit AI (optional) ───
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ─── AI Automation — Supabase Edge Function secrets (supabase secrets set ...) ───
# GEMINI_API_KEY=              # Primary Google AI Studio key (AIza…)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_API_KEY4–9            # Optional rotation pool

# ─── SERP (competitor + rank — Render env me set karo) ───
