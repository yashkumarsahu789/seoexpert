{
  "_meta": {
    "id": "keyword_pages_indexing_daily",
    "description": "Daily sitemap rebuild + Google/Bing/IndexNow ping for keyword pages",
    "activate": true,
    "snippetRefs": {
      "Indexing Run": "keyword-pages-indexing-run.js"
    }
  },
  "name": "Keyword Pages Indexing Daily",
  "nodes": [
    {
      "id": "schedule-kp-index",
      "name": "Every Day 9 AM IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "30 3 * * *" }]
        }
      }
    },
    {
      "id": "code-kp-index",
      "name": "Indexing Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": { "mode": "runOnceForAllItems", "jsCode": "" }
    },
    {
      "id": "webhook-kp-index",
      "name": "Indexing Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 480],
      "webhookId": "keyword-pages-indexing",
      "parameters": {
        "httpMethod": "POST",
        "path": "keyword-pages-indexing",
        "responseMode": "lastNode",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Day 9 AM IST": { "main": [[{ "node": "Indexing Run", "type": "main", "index": 0 }]] },
    "Indexing Webhook": { "main": [[{ "node": "Indexing Run", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
