{
  "_meta": {
    "id": "shop_rank_webhook",
    "description": "On-demand shop keyword rank check (all keywords, Bing→DDG→Google)",
    "activate": true,
    "snippetRefs": {
      "Rank Check": "shop-rank-check-run.js"
    }
  },
  "name": "Shop Rank Check",
  "nodes": [
    {
      "id": "webhook-shop-rank",
      "name": "Rank Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "shop-rank-check",
      "parameters": {
        "httpMethod": "POST",
        "path": "shop-rank-check",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "code-shop-rank",
      "name": "Rank Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": { "mode": "runOnceForAllItems", "jsCode": "" }
    },
    {
      "id": "respond-shop-rank",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "Rank Webhook": { "main": [[{ "node": "Rank Check", "type": "main", "index": 0 }]] },
    "Rank Check": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
